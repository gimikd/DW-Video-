{
  "expo": {
    "name": "DW Camera Calculator",
    "slug": "dw-camera-calculator",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.digitalwatchdog.cameracalculator"
    },
    "android": {
      "package": "com.digitalwatchdog.cameracalculator",
      "adaptiveIcon": { "backgroundColor": "#000000" }
    },
    "plugins": ["expo-router"],
    "experiments": { "typedRoutes": true }
  }
}
